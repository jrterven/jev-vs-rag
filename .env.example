MAX_FILE_MB=100
MAX_DOCUMENT_TOKENS=1000000
MAX_PDF_PAGES=2000
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
JEV_WINDOW_TOKENS=12000
PROVIDER_CONCURRENCY=2
REQUEST_TIMEOUT_MS=120000
PORT=3001
WEB_PORT=5174
DATA_DIR=./data
