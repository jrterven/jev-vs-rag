{
  "name": "jev-vs-rag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:large": "RUN_LARGE_TESTS=1 node --import tsx --test tests/extraction-large.test.ts",
    "test:live": "node --import tsx scripts/live-smoke.ts",
    "test:live:app": "node --import tsx scripts/app-live-smoke.ts",
    "dev:annotate": "concurrently -k -n annotate-api,annotate-web \"tsx watch annotation/server/index.ts\" \"vite --config annotation/vite.config.ts --host 127.0.0.1\"",
    "build:annotate": "tsc --noEmit -p annotation/tsconfig.json && tsc -p annotation/tsconfig.server.json && vite build --config annotation/vite.config.ts",
    "start:annotate": "node annotation/dist/runtime/server/index.js",
    "annotation:admin": "tsx annotation/server/cli.ts",
    "annotation:package": "node deploy/annotation/package.mjs",
    "test:annotate": "node --import tsx --test annotation/tests/*.test.ts",
    "check:annotate": "tsc --noEmit -p annotation/tsconfig.json",
    "research": "tsx research/cli.ts",
    "research:ragas:export": "tsx research/ragas/export.ts",
    "research:ragas:bridge": "tsx research/ragas/bridge.ts",
    "research:ragas:audit": "tsx research/ragas/audit.ts",
    "test:ragas:python": "research/.venv-ragas/bin/python -m unittest discover -s research/ragas -p 'test_*.py'",
    "test:research": "node --import tsx --test research/tests/*.test.ts",
    "test:research:python": "python3 -m unittest discover -s research/python -p 'test_*.py'",
    "test:deploy": "node --test deploy/annotation/tests/*.test.mjs",
    "check:research": "tsc --noEmit -p research/tsconfig.json",
    "test:all": "npm test && npm run test:annotate && npm run test:research && npm run test:research:python && npm run test:deploy && npm run results:verify",
    "check:all": "npm run check && npm run check:annotate && npm run check:research",
    "results:verify": "python3 results/verify.py",
    "research:study-readout": "tsx research/scripts/study-readout.ts",
    "research:ragas:study-export": "tsx research/ragas/study-export.ts",
    "research:ragas:study-analysis": "python3 research/ragas/study-analysis.py"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.5",
    "@lancedb/lancedb": "^0.23.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
