# Plain KEY=value only; no shell commands, quotes or variable interpolation.
ANNOTATION_PROJECT=jev-annotation
# Set a unique immutable tag per release before building.
ANNOTATION_IMAGE=jev-annotation:release-YYYYMMDD-1
ANNOTATION_ORIGIN=https://anota.example.com
ANNOTATION_BIND_PORT=13002
ANNOTATION_DATA_VOLUME=jev-annotation-data
# Leave empty when the existing proxy runs on the host.
ANNOTATION_PROXY_NETWORK=
ANNOTATION_PROXY_ALIAS=jev-annotation-upstream
